# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=local
PORT=3001
API_PREFIX=api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Asia/Bangkok
# Used to build links inside notification emails
PUBLIC_WEB_URL=http://localhost:3000
# This API's own public origin (no path). The unsubscribe link in an alert email points
# here rather than at the web app, so it keeps working even if the frontend is down or
# redeployed — an unsubscribe that 404s is the complaint the link exists to prevent.
PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local: the docker-compose container.
# Supabase: copy the *Session pooler* URI from Connect in the dashboard. Three traps:
#   1. The direct host (db.<ref>.supabase.co) has no A record — it is IPv6-only, so
#      Node's dns.lookup returns ENOTFOUND on any IPv4-only host. The pooler
#      (aws-0-<region>.pooler.supabase.com) resolves to IPv4 and works everywhere.
#   2. The database is always named `postgres`, never your project name.
#   3. Use the **session** pooler (port 5432), not the transaction pooler (6543):
#      transaction pooling drops LISTEN/NOTIFY and prepared statements.
DATABASE_URL=postgres://govjobs:govjobs@localhost:5433/govjobs
# Managed Postgres requires TLS; set false only for a plain local container
DB_SSL=false
DB_LOGGING=false
# Supabase's session pooler allows 15 clients in total, and every BullMQ queue and worker
# holds one of them (a worker also holds a LISTEN client, which cannot be shared). Measured:
# 17 in flight before this cap, 11 after.
DB_POOL_MAX=3

# ---------------------------------------------------------------------------
# Queue (BullMQ)
# ---------------------------------------------------------------------------
# BullMQ runs on the PostgreSQL backend, not Redis: it reuses DATABASE_URL over
# LISTEN/NOTIFY and keeps its own tables in QUEUE_SCHEMA (auto-migrated on first run).
# Requires PostgreSQL >= 13 and a *session*-mode connection — transaction pooling
# (Supabase port 6543) silently drops LISTEN/NOTIFY and the workers never wake.
#
# Why not Redis: at BullMQ's defaults (drainDelay 5s, stalledInterval 30s) a single
# *idle* worker issues ~605,000 commands/month. Upstash's free allowance is 500,000.
QUEUE_SCHEMA=bullmq
QUEUE_PREFIX=gov-jobs

# ---------------------------------------------------------------------------
# Cache (Upstash Redis, REST API)
# ---------------------------------------------------------------------------
# Optional. Unless BOTH are set the app falls back to an in-process Map, so local
# development and CI need no network service.
# These are the REST credentials from the Upstash console — the HTTP API, which is what
# @upstash/redis speaks. (They cannot drive BullMQ; that needs ioredis over TCP.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_PREFIX=gov-jobs
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TTL_DAYS=30
# A just-rotated refresh token stays usable this long, so a browser firing several
# requests at once does not sign itself out. 0 makes rotation strictly single-use.
REFRESH_ROTATION_GRACE_MS=15000
BCRYPT_ROUNDS=10
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Shared secret for POST /api/v1/internal/* — the external scheduler sends it
INTERNAL_API_KEY=change-me-internal

# ---------------------------------------------------------------------------
# Crawler
# ---------------------------------------------------------------------------
# Sent by every crawler. The sources are public and unauthenticated; identifying the
# crawler honestly is the price of reading them, and one string means a site operator who
# wants to block us can do it in one rule rather than five.
CRAWLER_USER_AGENT=gov-jobs-alert/1.0 (+https://github.com/born-sorravit/gov-jobs-backend; public job announcement aggregator)

# --- Per source ---
OCSC_API_BASE_URL=https://jobapp.ocsc.go.th/jobapi
OCSC_PORTAL_BASE_URL=https://job.ocsc.go.th/portal
OCSC_TIMEOUT_MS=30000
# Sent as User-Agent to the OCSC portal. The source is public and unauthenticated;
# identifying the crawler honestly is the price of scraping it.
OCSC_USER_AGENT=gov-jobs-alert/1.0 (+https://github.com/born-sorravit/gov-jobs-backend; public job announcement aggregator)
# กรมที่ดิน publishes no API, so this is the HTML listing the crawler reads. Page 1 carries
# the newest announcements; the archive runs to ~45 pages of mostly historical notices, so
# only the first DOL_LISTING_PAGES are swept each crawl.
DOL_LISTING_URL=https://www.dol.go.th/department-news/activity-updates/personnel-divisions-news/examination
DOL_LISTING_PAGES=2
DOL_TIMEOUT_MS=30000
# กระทรวงดิจิทัลเพื่อเศรษฐกิจและสังคม — the "สมัครงาน" news category. Same shape as DOL:
# no API, page 1 carries the newest announcements, archive is ~7 pages.
MDES_LISTING_URL=https://mdes.go.th/news/7
MDES_LISTING_PAGES=2
MDES_TIMEOUT_MS=30000
# MDES answers 403 to a burst of requests and recovers on its own, so the crawl is spaced
# out rather than retried into the block. 0 disables the pause.
MDES_REQUEST_DELAY_MS=800
# --- Scheduling (all sources) ---
# In-process cron. Leave false on Render free tier (the instance sleeps when idle) and
# drive crawls from an external scheduler hitting the internal endpoint instead.
CRAWLER_SCHEDULER_ENABLED=true
# How often that cron runs *every* registered source, in sequence. Falls back to the
# older OCSC_CRAWL_INTERVAL_MINUTES when unset, so existing environments keep their value.
CRAWLER_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# Document processing (PDF text extraction)
# ---------------------------------------------------------------------------
# The process that reads PDFs is the one serving the API, on 512 MB. A source is free to
# publish a 200 MB scan, so anything larger is refused rather than loaded — by the declared
# content-length and again while downloading, because that header is a claim. DOL's largest
# announcement so far is ~14 MB.
DOCUMENT_MAX_BYTES=16777216
# Below this many characters the PDF is treated as having no usable text layer and is
# recorded INSUFFICIENT_TEXT, which is what OCR will look for. A scan is not empty — it
# yields a little header junk — so the test cannot be "is it zero".
DOCUMENT_MIN_TEXT_LENGTH=200
DOCUMENT_TIMEOUT_MS=60000
# How many unread attachments one crawl offers the queue. The first crawl after this shipped
# finds every existing attachment unread, and reading thousands of PDFs in one go on a small
# instance is not something to start by accident — the backlog drains a batch per crawl.
# Re-processing anything is: UPDATE job_attachment SET extraction_status = 'PENDING' ...
DOCUMENT_BATCH_SIZE=50
# Whether alert keywords are matched against document text as well as the title.
# OFF by default, on evidence: OCSC splits a multi-position announcement into one job row per
# position, all sharing one PDF, so every position named in that PDF already has its own row.
# Measured on the live corpus, all 9 extra matches were rows the announcement already had —
# no new position found, and the reader would be emailed about positions they never searched
# for. Generic keywords are worse: "ปริญญาตรี" matches 0 by title and 11 of 12 by document.
# Turn on for a deployment dominated by sources that publish one row per announcement.
DOCUMENT_MATCH_TEXT=false

# ---------------------------------------------------------------------------
# Email (Resend in deployment; "console" just logs the payload)
# ---------------------------------------------------------------------------
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=Gov Jobs Alert <onboarding@resend.dev>
MAIL_REPLY_TO=
