# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=local
PORT=3001
API_PREFIX=api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Asia/Bangkok
# Used to build links inside notification emails
PUBLIC_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local: the docker-compose container.
# Supabase: copy the *Session pooler* URI from Connect in the dashboard. Three traps:
#   1. The direct host (db.<ref>.supabase.co) has no A record — it is IPv6-only, so
#      Node's dns.lookup returns ENOTFOUND on any IPv4-only host. The pooler
#      (aws-0-<region>.pooler.supabase.com) resolves to IPv4 and works everywhere.
#   2. The database is always named `postgres`, never your project name.
#   3. Use the **session** pooler (port 5432), not the transaction pooler (6543):
#      transaction pooling drops LISTEN/NOTIFY and prepared statements.
DATABASE_URL=postgres://govjobs:govjobs@localhost:5433/govjobs
# Managed Postgres requires TLS; set false only for a plain local container
DB_SSL=false
DB_LOGGING=false

# ---------------------------------------------------------------------------
# Queue (BullMQ)
# ---------------------------------------------------------------------------
# BullMQ runs on the PostgreSQL backend, not Redis: it reuses DATABASE_URL over
# LISTEN/NOTIFY and keeps its own tables in QUEUE_SCHEMA (auto-migrated on first run).
# Requires PostgreSQL >= 13 and a *session*-mode connection — transaction pooling
# (Supabase port 6543) silently drops LISTEN/NOTIFY and the workers never wake.
#
# Why not Redis: at BullMQ's defaults (drainDelay 5s, stalledInterval 30s) a single
# *idle* worker issues ~605,000 commands/month. Upstash's free allowance is 500,000.
QUEUE_SCHEMA=bullmq
QUEUE_PREFIX=gov-jobs

# ---------------------------------------------------------------------------
# Cache (Upstash Redis, REST API)
# ---------------------------------------------------------------------------
# Optional. Unless BOTH are set the app falls back to an in-process Map, so local
# development and CI need no network service.
# These are the REST credentials from the Upstash console — the HTTP API, which is what
# @upstash/redis speaks. (They cannot drive BullMQ; that needs ioredis over TCP.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_PREFIX=gov-jobs
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TTL_DAYS=30
# A just-rotated refresh token stays usable this long, so a browser firing several
# requests at once does not sign itself out. 0 makes rotation strictly single-use.
REFRESH_ROTATION_GRACE_MS=15000
BCRYPT_ROUNDS=10
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Shared secret for POST /api/v1/internal/* — the external scheduler sends it
INTERNAL_API_KEY=change-me-internal

# ---------------------------------------------------------------------------
# Crawler
# ---------------------------------------------------------------------------
OCSC_API_BASE_URL=https://jobapp.ocsc.go.th/jobapi
OCSC_PORTAL_BASE_URL=https://job.ocsc.go.th/portal
OCSC_CRAWL_INTERVAL_MINUTES=60
OCSC_TIMEOUT_MS=30000
# In-process cron. Leave false on Render free tier (the instance sleeps when idle) and
# drive crawls from an external scheduler hitting the internal endpoint instead.
CRAWLER_SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Email (Resend in deployment; "console" just logs the payload)
# ---------------------------------------------------------------------------
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=Gov Jobs Alert <onboarding@resend.dev>
MAIL_REPLY_TO=
