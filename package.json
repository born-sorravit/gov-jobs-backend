{
	"name": "gov-jobs-backend",
	"version": "0.0.1",
	"description": "Thai government job announcement aggregator and alert service",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "biome format --write",
		"start:local": "NODE_ENV=local nest start --watch",
		"start:dev": "NODE_ENV=development nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "NODE_ENV=production node dist/main",
		"start:prod:docker": "node ./node_modules/typeorm/cli.js migration:run -d dist/shared/database/typeorm.config.js && NODE_ENV=production node dist/main",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "jest --runInBand",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
		"typeorm": "ts-node ./node_modules/typeorm/cli",
		"migration:run": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/shared/database/typeorm.config.js",
		"migration:generate": "npm run build && node ./node_modules/typeorm/cli.js migration:generate ./src/shared/database/migrations/$npm_config_name -d ./dist/shared/database/typeorm.config.js",
		"migration:create": "node ./node_modules/typeorm/cli.js migration:create ./src/shared/database/migrations/$npm_config_name",
		"migration:revert": "node ./node_modules/typeorm/cli.js migration:revert -d ./dist/shared/database/typeorm.config.js",
		"seed:run": "npm run build && node ./dist/shared/database/seeds/seed.js",
		"admin:promote": "npm run build && node ./dist/shared/database/seeds/promote-admin.js"
	},
	"dependencies": {
		"@nestjs/bullmq": "^11.0.5",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.0.1",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/swagger": "^11.4.7",
		"@nestjs/throttler": "^6.7.0",
		"@nestjs/typeorm": "^11.0.3",
		"@upstash/redis": "^1.39.0",
		"bcryptjs": "^3.0.3",
		"bullmq": "^6.3.8",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"dotenv": "^18.0.1",
		"helmet": "^8.3.0",
		"ioredis": "^5.11.1",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"pg": "^8.23.0",
		"reflect-metadata": "^0.2.2",
		"resend": "^6.28.1",
		"rxjs": "^7.8.1",
		"typeorm": "^1.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.0.0",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^7.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^17.0.0",
		"jest": "^30.0.0",
		"prettier": "^3.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"src/**/*.(t|j)s"
		],
		"coverageDirectory": "./coverage",
		"testEnvironment": "node",
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/src/$1"
		}
	}
}
